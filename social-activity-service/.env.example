# --- server ---
PORT=4010
LOG_LEVEL=info
# Bearer token callers must send (min 16 chars). Unset = unauthenticated (local dev only).
SERVICE_API_TOKEN=

DATABASE_PATH=./data/social-activity.db

# --- provider ---
# "mock" runs everything in-memory with no spend. Switch to "followiz" once the key is added.
PROVIDER=mock
FOLLOWIZ_API_URL=https://followiz.com/api/v2
FOLLOWIZ_API_KEY=
PROVIDER_TIMEOUT_MS=20000
PROVIDER_MIN_INTERVAL_MS=250

# --- background workers ---
WORKERS_ENABLED=true
POLL_INTERVAL_MS=30000
POLL_MIN_BACKOFF_MS=120000
POLL_MAX_BACKOFF_MS=1800000
CATALOG_SYNC_INTERVAL_MS=21600000
REFILL_CHECK_INTERVAL_MS=3600000
AUTO_REFILL_EVERY_DAYS=7
DEFAULT_REFILL_DAYS=0
STUCK_PENDING_HOURS=12

# --- money ---
MIN_BALANCE_BUFFER_USD=0
LOW_BALANCE_ALERT_USD=10

# --- website traffic ---
TRAFFIC_UTM_SOURCE=growthhackz
TRAFFIC_UTM_MEDIUM=test-traffic

# --- WURK package (x402, USDC on Solana). Separate from PROVIDER; never calls Followiz. ---
WURK_BASE_URL=https://wurkapi.fun
# Dedicated Peak wallet secret (base58 64-byte, 128-char hex, or solana-keygen JSON array). Server secret only.
WURK_SOLANA_PRIVATE_KEY=
# Nothing is signed until this is true AND the key is set. Without them, orders stop at the quote (dry run).
WURK_LIVE_PAYMENTS_ENABLED=false
WURK_PAYTO_ALLOWLIST=SAT8g2xU7AFy7eUmNJ9SNrM6yYo7LDCi13GXJ8Ez9kC
WURK_MAX_FOLLOWERS_USDC=1.40
WURK_MAX_POST_MIX_USDC=2.25
WURK_MAX_TG_BATCH_USDC=0.45
WURK_PACKAGE_MAX_USDC=4.55
WURK_DAILY_MAX_USDC=25
WURK_SMOKE_MAX_USDC=1
WURK_TG_SECOND_BATCH_DELAY_MIN=30
WURK_TICK_MS=15000
WURK_STATUS_POLL_MS=600000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
