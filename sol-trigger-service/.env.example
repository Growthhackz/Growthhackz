# --- server ---
PORT=4030
LOG_LEVEL=info
# Dashboard login password (min 12 chars).
DASHBOARD_PASSWORD=
# Bearer token your upstream system sends to POST /v1/trigger (min 24 chars). Generate: openssl rand -hex 24
TRIGGER_API_TOKEN=
# Encrypts wallet private keys at rest and signs sessions (min 32 chars). Never change it once wallets are added.
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# true behind HTTPS (Railway). Set false only for plain-http localhost.
COOKIE_SECURE=true

DATABASE_PATH=./data/sol-trigger.db

# --- Solana ---
# Use a paid RPC in production (Helius, Triton, QuickNode); the public one is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Free tier. With a key from portal.jup.ag use https://api.jup.ag/swap/v1 and set JUPITER_API_KEY.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# --- background loop ---
WORKERS_ENABLED=true
TICK_INTERVAL_MS=3000
