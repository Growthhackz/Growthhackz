CONTENT_MACHINE_URL=http://localhost:4020
# A service key from POST /v1/keys (admin). Shown once.
CONTENT_MACHINE_API_KEY=
# Only for Binance publishing; install the official binance/binance-skills-hub first.
BINANCE_SQUARE_SKILL_DIR=
BINANCE_SQUARE_OPENAPI_KEY=
FFMPEG_PATH=ffmpeg
# Reddit (text posts to r/moonshots and r/solanamemecoins). Either a cookie export from a logged-in browser
# (Cookie-Editor → Export → JSON, on reddit.com), or username/password (2FA off).
REDDIT_COOKIES=
# Reddit blocks datacenter IPs (incl. Railway): a residential proxy for Reddit traffic only, http://user:pass@host:port
REDDIT_PROXY=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_STATE_PATH=./reddit-session.json
# Directory listings (one account per site). Leave empty to skip a site.
COINSNIPER_EMAIL=
COINSNIPER_PASSWORD=
COINVOTE_EMAIL=
COINVOTE_PASSWORD=
# Saved logins, plus screenshots/HTML when a form can't be filled.
DIRECTORY_STATE_DIR=.
DIRECTORY_DEBUG_DIR=./debug
# CoinMarketCap community posts from our profile. Leave empty to skip.
CMC_EMAIL=
CMC_PASSWORD=
CMC_PROFILE_HANDLE=peakbuybot
# 1888PressRelease. The company must exist on the 1888 account (Add/Manage Company); its name can't be changed there.
PRESS1888_USERNAME=
PRESS1888_PASSWORD=
PRESS1888_COMPANY=
PRESS_CONTACT_NAME=
PRESS_CONTACT_EMAIL=
PRESS_CONTACT_PHONE=
PRESS_CONTACT_ZIP=
# Bitcointalk: cookie export from a browser logged in with "Always stay logged in" (login has a captcha).
BTCTALK_COOKIES=
BTCTALK_BOARD=67
