# --- server ---
PORT=4020
LOG_LEVEL=info
# Admin bearer token (min 16 chars): settings, service keys, connectors, reconciliation.
ADMIN_API_TOKEN=
# Encrypts provider credentials saved via PUT /v1/settings (min 32 chars). Never change it once set.
CONFIG_ENCRYPTION_KEY=

DATABASE_PATH=./data/content-machine.db
ASSET_DIR=./data/assets

# Public origin; hub links in announcements and callbacks point here.
PUBLIC_BASE_URL=http://localhost:4020
# Serve /projects/:id (HTML or JSON) and its assets without auth.
PUBLIC_HUB_ENABLED=false

# --- providers (optional here; values saved via PUT /v1/settings take precedence) ---
GEMINI_API_KEY=
TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image
TELEGRAPH_TOKEN=
TELEGRAM_BOT_TOKEN=
CALLBACK_URL=
CALLBACK_SECRET=

# --- background loop ---
WORKERS_ENABLED=true
TICK_INTERVAL_MS=5000
JOBS_PER_TICK=10
RENDERER_STALE_MS=120000
