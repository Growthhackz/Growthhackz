{
  "openapi": "3.0.3",
  "info": {
    "title": "Peak Swap API",
    "version": "2.0.0",
    "description": "Solana mainnet; customer wallet signing. Swaps route directly through a single SOL-paired pool on Pump.fun, PumpSwap, Raydium (CPMM, AMM v4) or Meteora (DAMM v2, DLMM). Peak fee: 100 bps of the SOL side, charged on top for buys and from proceeds for sells. Owner-private deployment until owner changes Site access."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service readiness",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid integration key"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service inactive or unavailable"
          }
        }
      }
    },
    "/tokens": {
      "get": {
        "summary": "Token metadata by mint address (SOL and USDC also by symbol)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid integration key"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service inactive or unavailable"
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/orders": {
      "post": {
        "summary": "Create an order: simulated best-pool quote plus unsigned transaction including the Peak fee. One side must be SOL.",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid integration key"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service inactive or unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "inputMint": {
                    "type": "string"
                  },
                  "outputMint": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "taker": {
                    "type": "string"
                  },
                  "slippageBps": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 500,
                    "default": 100
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "inputMint",
                  "outputMint",
                  "amount",
                  "taker"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/execute": {
      "post": {
        "summary": "Submit the exact wallet-signed transaction to Solana. status: confirmed | failed | rejected | expired | unknown",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid integration key"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service inactive or unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "signedTransaction": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "signedTransaction"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Read confirmation status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid integration key"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service inactive or unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  }
}
